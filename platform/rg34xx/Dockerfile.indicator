# C numeric portability only; not RG34XX firmware, ARM7 execution or emulator.
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/helix
COPY rom-source/overlay/src/helix_indicator_model.c ./rom-source/overlay/src/
COPY rom-source/overlay/include/helix_indicator_model.h ./rom-source/overlay/include/
COPY genetics/__init__.py genetics/lab_simulation.py ./genetics/
COPY tests/test_helix_indicator_native.py ./tests/
COPY tests/fixtures/helix-indicator-hill-v1.json ./tests/fixtures/
COPY scripts/verify-helix-indicator-native.py ./scripts/
USER 65532:65532
CMD ["python", "scripts/verify-helix-indicator-native.py"]
