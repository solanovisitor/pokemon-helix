+	setvar VAR_AURORA_NORTH_CLUES, AURORA_NORTH_ALL_CLUES
+Route103_EventScript_NorthReedRead::
+	msgbox Route103_Text_NorthReed, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+#endif
+
+Route103_EventScript_NorthStone::
+	lock
+	faceplayer
+#if AURORA_ADVENTURE_VARIANT != 2
+	goto Route103_EventScript_NorthDormant
+#else
+	goto_if_eq VAR_AURORA_NORTH_POOL, AURORA_NORTH_UNMET, Route103_EventScript_NorthMeetMira
+	goto_if_lt VAR_AURORA_NORTH_POOL, AURORA_NORTH_BATTLE_WON, Route103_EventScript_NorthBlockedClue
+	special GetAuroraAdventurePartnerReady
+	goto_if_ne VAR_RESULT, TRUE, Route103_EventScript_NorthNeedsPartner
+	goto_if_eq VAR_AURORA_NORTH_CLUES, AURORA_NORTH_STONE, Route103_EventScript_NorthStoneRead
+	goto_if_eq VAR_AURORA_NORTH_CLUES, AURORA_NORTH_ALL_CLUES, Route103_EventScript_NorthStoneRead
+	goto_if_eq VAR_AURORA_NORTH_CLUES, AURORA_NORTH_REED, Route103_EventScript_NorthStoneJoin
+	setvar VAR_AURORA_NORTH_CLUES, AURORA_NORTH_STONE
+	goto Route103_EventScript_NorthStoneRead
+Route103_EventScript_NorthStoneJoin::
+	setvar VAR_AURORA_NORTH_CLUES, AURORA_NORTH_ALL_CLUES
+Route103_EventScript_NorthStoneRead::
+	msgbox Route103_Text_NorthStone, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+#endif
+
+Route103_EventScript_NorthDormant::
+	msgbox Route103_Text_NorthDormant, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+
+#if AURORA_ADVENTURE_VARIANT != 0
+Route103_EventScript_NorthPool::
+	goto_if_eq VAR_AURORA_NORTH_POOL, AURORA_NORTH_UNMET, Route103_EventScript_NorthMeetMira
+#if AURORA_ADVENTURE_VARIANT == 1
+	goto_if_eq VAR_AURORA_NORTH_CLUES, 0, Route103_EventScript_NorthNeedReed
+#endif
+	goto_if_ge VAR_AURORA_NORTH_POOL, AURORA_NORTH_BATTLE_WON, Route103_EventScript_NorthPractice
+	msgbox Route103_Text_NorthDisturbed, MSGBOX_DEFAULT
+	goto Route103_EventScript_NorthBattleOffer
+Route103_EventScript_NorthPractice::
+	msgbox Route103_Text_NorthPractice, MSGBOX_DEFAULT
+Route103_EventScript_NorthBattleOffer::
+	special GetAuroraAdventureBattleReady
+	goto_if_ne VAR_RESULT, TRUE, Route103_EventScript_NorthNeedsPair
+	goto_if_eq VAR_0x8007, 1, Route103_EventScript_NorthRecoveryOffer
+	goto Route103_EventScript_NorthConfirmBattle
+Route103_EventScript_NorthRecoveryOffer::
+	msgbox Route103_Text_NorthRecovery, MSGBOX_DEFAULT
+Route103_EventScript_NorthConfirmBattle::
+	msgbox Route103_Text_NorthBattleOffer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Route103_EventScript_AuroraSignalFinish
+	closemessage
+#if AURORA_ADVENTURE_VARIANT == 1
+	setwildbattle SPECIES_POOCHYENA, 3, ITEM_NONE, SPECIES_POOCHYENA, 3, ITEM_NONE
+#else
+	setwildbattle SPECIES_POOCHYENA, 3, ITEM_NONE, SPECIES_ZIGZAGOON, 3, ITEM_NONE
+#endif
+	dowildbattle
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_ne VAR_RESULT, B_OUTCOME_WON, Route103_EventScript_NorthRetry
+	special GetAuroraAdventureBattleWon
+	goto_if_ne VAR_RESULT, TRUE, Route103_EventScript_NorthRetry
+	goto_if_ge VAR_AURORA_NORTH_POOL, AURORA_NORTH_BATTLE_WON, Route103_EventScript_NorthPracticeWon
+	setvar VAR_AURORA_NORTH_POOL, AURORA_NORTH_BATTLE_WON
+	msgbox Route103_Text_NorthBattleWon, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+Route103_EventScript_NorthPracticeWon::
+	msgbox Route103_Text_NorthPracticeWon, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+Route103_EventScript_NorthRetry::
+	msgbox Route103_Text_NorthRetry, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+Route103_EventScript_NorthNeedsPair::
+	msgbox Route103_Text_NorthNeedsPair, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+Route103_EventScript_NorthNeedsPartner::
+	msgbox Route103_Text_NorthNeedsPartner, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+Route103_EventScript_NorthMeetMira::
+	msgbox Route103_Text_NorthMeetMira, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+Route103_EventScript_NorthNeedReed::
+	msgbox Route103_Text_NorthNeedReed, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+Route103_EventScript_NorthBlockedClue::
+	msgbox Route103_Text_NorthBlockedClue, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+#endif
+
+Route103_Text_NorthDormant:
+	.string "An old nursery marker.\n"
+	.string "It hums quietly in the reeds.$"
+#if AURORA_ADVENTURE_VARIANT != 0
+Route103_Text_NorthMeetMira:
+	.string "The marker repeats: NORTH POOL.\n"
+	.string "Ask MIRA in OLDALE about it.$"
+Route103_Text_NorthNeedsPartner:
+	.string "Bring a healthy partner from your\n"
+	.string "new family to hear this marker.\p"
+	.string "If boxed, withdraw it at the PC.\n"
+	.string "If fainted, visit the CENTER.$"
+Route103_Text_NorthNeedsPair:
+	.string "Your two new family partners\n"
+	.string "must both lead this battle.\p"
+	.string "Put them first and second.\n"
+	.string "Heal both at the CENTER.\p"
+	.string "If either is boxed, withdraw it.\n"
+	.string "The beacon will wait for you.\p"
+	.string "If a partner has left your care,\n"
+	.string "two healthy POKéMON can carry\l"
+	.string "the family's saved field notes.$"
+Route103_Text_NorthNeedReed:
+	.string "The pool is missing its safe note.\n"
+	.string "Read the REED MARKER to the west.$"
+Route103_Text_NorthBlockedClue:
+	.string "Restless calls drown out the note.\n"
+	.string "Calm the river beacon to the east.\p"
+	.string "Then this marker can answer.$"
+Route103_Text_NorthReed:
+#if AURORA_ADVENTURE_VARIANT == 1
+	.string "REED MARKER: Your partner hears\n"
+	.string "a low note beneath the rustling.\p"
+	.string "It is the nursery's safe call!\n"
+	.string "Take both partners to the beacon\l"
+	.string "beside the water, just east of here.$"
+#else
+	.string "REED MARKER: Three rising notes.\n"
+	.string "Young POKéMON leave by this path.\p"
+	.string "The STONE MARKER farther west\n"
+	.string "records the other half.\p"
+	.string "When both are read, tell MIRA.$"
+#endif
+Route103_Text_NorthStone:
+	.string "STONE MARKER: Two falling notes.\n"
+	.string "A reply points toward safe water.\p"
+	.string "The REED MARKER farther east\n"
+	.string "records the other half.\p"
+	.string "When both are read, tell MIRA.$"
+Route103_Text_NorthDisturbed:
+#if AURORA_ADVENTURE_VARIANT == 1
+	.string "Two POOCHYENA block the pool.\n"
+	.string "Your family repeats the reed's call.\p"
+	.string "Win together to guide them away\n"
+	.string "from the nursery entrance.$"
+#else
+	.string "A POOCHYENA and ZIGZAGOON\n"
+	.string "chase each other's broken calls.\p"
+	.string "Win together to quiet the pool\n"
+	.string "and hear its two hidden channels.$"
+#endif
+Route103_Text_NorthRecovery:
+	.string "A family partner has left your care.\n"
+	.string "Its field notes still hold the call.\p"
+	.string "Your two healthy lead POKéMON\n"
+	.string "can carry those notes together.$"
+Route103_Text_NorthBattleOffer:
+	.string "Begin a DOUBLE BATTLE to carry\n"
+	.string "your family's call to the pool?$"
+Route103_Text_NorthRetry:
+	.string "The nursery still needs help.\n"
+	.string "No discovery was lost.\p"
+	.string "Heal both partners, then return.\n"
+	.string "A win together will calm the pool.$"
+Route103_Text_NorthBattleWon:
+#if AURORA_ADVENTURE_VARIANT == 1
+	.string "The wild pair settles in the grass.\n"
+	.string "Your partners carry the safe note.\p"
+	.string "NORTH POOL's entrance is open!\n"
+	.string "Report your discovery to MIRA.$"
+#else
+	.string "The pool grows quiet. Two replies\n"
+	.string "come from markers to the west.\p"
+	.string "Read REED near here and STONE\n"
+	.string "farther west, in either order.\p"
+	.string "Then tell MIRA what you heard.$"
+#endif
+Route103_Text_NorthPractice:
+	.string "NORTH POOL is quiet. A wild pair\n"
+	.string "waits in the grass for practice.$"
+Route103_Text_NorthPracticeWon:
+	.string "Both partners answer together.\n"
+	.string "Your discoveries stay recorded.$"
+#endif
+
+#if AURORA_COMBAT_ENABLED
+HelixWild_Gate:
+	special GetAuroraCombatState
+	goto_if_eq VAR_RESULT, 47, Route103_EventScript_NorthPool
+	goto_if_eq VAR_RESULT, 63, Route103_EventScript_NorthPool
+HelixWild_Offer:
+	msgbox HelixWild_Text_Offer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Route103_EventScript_AuroraSignalFinish
+	closemessage
+	setwildbattle SPECIES_AURORA_FAMILY_THREE, 5
+	special PrepareAuroraCombatEncounter
+	goto_if_ne VAR_RESULT, 1, HelixWild_Unavailable
+	dowildbattle
+	special FinishAuroraCombatEncounter
+	goto_if_eq VAR_RESULT, 1, HelixWild_Captured
+	msgbox HelixWild_Text_Retry, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+HelixWild_Captured:
+	msgbox HelixWild_Text_Captured, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+HelixWild_Unavailable:
+	msgbox HelixWild_Text_Unavailable, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+HelixWild_Text_Offer:
+	.string "A wild river partner answers!\n"
+	.string "Its traits give it its own strengths.\p"
+	.string "Approach it? You can catch this\n"
+	.string "partner with a POKé BALL.$"
+HelixWild_Text_Retry:
+	.string "The same partner waits by the water.\n"
+	.string "Rest, then try again when ready.$"
+HelixWild_Text_Captured:
+	.string "You caught that very same partner!\n"
+	.string "Its traits and pattern stay its own.\p"
+	.string "Bring both parents to the woman\n"
+	.string "at OLDALE's field lab. Save first!$"
+HelixWild_Text_Unavailable:
+	.string "If this partner joined you already,\n"
+	.string "look in your party or PC BOX.\p"
+	.string "Otherwise meet the scientist in\n"
+	.string "OLDALE's northwest house first.$"
+#endif
