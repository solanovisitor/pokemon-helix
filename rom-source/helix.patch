+static void SwitchOptionPage(u8 taskId)
+{
+    gHelixSettingsPage ^= 1;
+    gHelixSettingsSubmenu = HELIX_MAIN;
+    gHelixSettingsSubselection = 0;
+    if (gHelixSettingsPage)
+    {
+        HelixSettings_Open();
+        DrawHelixSettings();
+    }
+    else
+    {
+        HelixSettings_Close();
+        DrawOptionMenuTexts();
+        DrawClassicChoices(taskId);
+        HighlightOptionMenuItem(gTasks[taskId].tMenuSelection);
+        CopyWindowToVram(WIN_OPTIONS, COPYWIN_GFX);
+    }
+    DrawHeaderText();
+}
+
+static void HelixSubmenuBack(void)
+{
+    if (gHelixSettingsSubmenu == HELIX_CONFIRM)
+    {
+        gHelixSettingsSubmenu = HELIX_KEY;
+        gHelixSettingsSubselection = 0;
+    }
+    else if (gHelixSettingsSubmenu == HELIX_KEY)
+    {
+        gHelixSettingsSubmenu = HELIX_ADVANCED;
+        gHelixSettingsSubselection = sHelixKeyProvider + 1;
+    }
+    else
+    {
+        gHelixSettingsSubmenu = HELIX_MAIN;
+        gHelixSettingsSubselection = 0;
+    }
+}
+
+static void ProcessHelixInput(u8 taskId)
+{
+    bool32 changed = HelixSettings_Update();
+    u16 count = gHelixSettingsSubmenu == HELIX_TIMEZONE ? HELIX_TIMEZONE_COUNT
+        : gHelixSettingsSubmenu == HELIX_ADVANCED ? 4 : gHelixSettingsSubmenu == HELIX_KEY ? 3 : 2;
+    if (JOY_NEW(B_BUTTON))
+    {
+        if (gHelixSettingsSubmenu)
+        {
+            HelixSubmenuBack();
+            DrawHelixSettings();
+        }
+        else
+        {
+            // B preserves the original apply/exit behavior of classic Options.
+            HelixSettings_Close();
+            gTasks[taskId].func = Task_OptionMenuSave;
+        }
+        return;
+    }
+    if (gHelixSettingsSubmenu)
+    {
+        if (gHelixSettingsSubmenu == HELIX_ACCOUNT)
+        {
+            if (JOY_NEW(A_BUTTON)) { HelixSubmenuBack(); changed = TRUE; }
+        }
+        else if (gHelixSettingsSubmenu == HELIX_TIMEZONE && JOY_NEW(L_BUTTON | R_BUTTON))
+        {
+            // Physical shoulder input wins over the L=A remapping.
+            if (JOY_NEW(L_BUTTON))
+                gHelixSettingsSubselection = gHelixSettingsSubselection >= 5 ? gHelixSettingsSubselection - 5 : 0;
+            else
+                gHelixSettingsSubselection = gHelixSettingsSubselection + 5 < count ? gHelixSettingsSubselection + 5 : count - 1;
+            changed = TRUE;
+        }
+        else if (JOY_NEW(L_BUTTON | R_BUTTON))
+        {
+            // Shoulders never confirm a key import/remove under L=A.
+        }
+        else if (JOY_NEW(DPAD_UP | DPAD_DOWN))
+        {
+            if (JOY_NEW(DPAD_UP))
+                gHelixSettingsSubselection = gHelixSettingsSubselection ? gHelixSettingsSubselection - 1 : count - 1;
+            else
+                gHelixSettingsSubselection = gHelixSettingsSubselection + 1 < count ? gHelixSettingsSubselection + 1 : 0;
+            changed = TRUE;
+        }
+        else if (gHelixSettingsSubmenu == HELIX_ADVANCED && gHelixSettingsSubselection == 0 && JOY_NEW(DPAD_LEFT | DPAD_RIGHT | A_BUTTON))
+            changed |= HelixSettings_Request(HELIX_SETTINGS_SET_VOICE, JOY_NEW(DPAD_LEFT) ? 0 : JOY_NEW(DPAD_RIGHT) ? 1 : !gHelixSettingsView.voiceEnabled);
+        else if (JOY_NEW(A_BUTTON))
+        {
+            if (gHelixSettingsSubmenu == HELIX_TIMEZONE)
+                changed |= HelixSettings_Request(HELIX_SETTINGS_SET_TIMEZONE, gHelixSettingsSubselection);
+            else if (gHelixSettingsSubmenu == HELIX_ADVANCED)
+            {
+                if (gHelixSettingsSubselection == 3)
+                    HelixSubmenuBack();
+                else
+                {
+                    sHelixKeyProvider = gHelixSettingsSubselection - 1;
+                    gHelixSettingsSubmenu = HELIX_KEY;
+                    gHelixSettingsSubselection = 0;
+                    HelixSettings_Request(HELIX_SETTINGS_CHECK_KEYS, 0);
+                }
+                changed = TRUE;
+            }
+            else if (gHelixSettingsSubmenu == HELIX_KEY)
+            {
+                if (gHelixSettingsSubselection == 2)
+                    HelixSubmenuBack();
+                else
+                {
+                    sHelixKeyOperation = gHelixSettingsSubselection == 0 ? HELIX_SETTINGS_IMPORT_COPIED_KEY : HELIX_SETTINGS_REMOVE_KEY;
+                    gHelixSettingsSubmenu = HELIX_CONFIRM;
+                    gHelixSettingsSubselection = 0; // Cancel is always the default.
+                }
+                changed = TRUE;
+            }
+            else if (gHelixSettingsSubmenu == HELIX_CONFIRM)
+            {
+                if (gHelixSettingsSubselection == 0)
+                    HelixSubmenuBack();
+                else if (HelixSettings_Request(sHelixKeyOperation, sHelixKeyProvider))
+                    HelixSubmenuBack();
+                changed = TRUE;
+            }
+        }
+    }
+    else if (JOY_NEW(DPAD_UP))
+    {
+        gHelixSettingsSelection = gHelixSettingsSelection ? gHelixSettingsSelection - 1 : 4;
+        changed = TRUE;
+    }
+    else if (JOY_NEW(DPAD_DOWN))
+    {
+        gHelixSettingsSelection = gHelixSettingsSelection < 4 ? gHelixSettingsSelection + 1 : 0;
+        changed = TRUE;
+    }
+    else if (gHelixSettingsSelection == 1 && JOY_NEW(A_BUTTON))
+    {
+        gHelixSettingsSubmenu = HELIX_ACCOUNT;
+        gHelixSettingsSubselection = 0;
+        changed = TRUE;
+    }
+    else if (gHelixSettingsSelection == 3 && JOY_NEW(A_BUTTON))
+    {
+        gHelixSettingsSubmenu = HELIX_TIMEZONE;
+        gHelixSettingsSubselection = gHelixSettingsView.timezoneIndex < HELIX_TIMEZONE_COUNT ? gHelixSettingsView.timezoneIndex : 0;
+        changed = TRUE;
+    }
+    else if (gHelixSettingsSelection == 4 && JOY_NEW(A_BUTTON))
+    {
+        gHelixSettingsSubmenu = HELIX_ADVANCED;
+        gHelixSettingsSubselection = 0;
+        HelixSettings_Request(HELIX_SETTINGS_CHECK_KEYS, 0);
+        changed = TRUE;
+    }
+    else if (!gHelixSettingsView.pending && gHelixSettingsView.available)
+    {
+        if (gHelixSettingsSelection == 0 && JOY_NEW(DPAD_LEFT | DPAD_RIGHT | A_BUTTON))
+            changed |= HelixSettings_Request(HELIX_SETTINGS_SET_INTERNET, JOY_NEW(DPAD_LEFT) ? 0 : JOY_NEW(DPAD_RIGHT) ? 1 : !gHelixSettingsView.connectivity);
+        else if (gHelixSettingsSelection == 2 && JOY_NEW(DPAD_LEFT | DPAD_RIGHT))
+            changed |= HelixSettings_Request(HELIX_SETTINGS_SET_MICROPHONE, JOY_NEW(DPAD_RIGHT) ? 1 : 0);
+        else if (gHelixSettingsSelection == 2 && JOY_NEW(A_BUTTON))
+            changed |= HelixSettings_Request(HELIX_SETTINGS_OPEN_MICROPHONE, 0);
+        else if (gHelixSettingsSelection == 3 && JOY_NEW(DPAD_LEFT))
+            changed |= HelixSettings_Request(HELIX_SETTINGS_TIME_AUTO, 0);
+        else if (gHelixSettingsSelection == 4 && JOY_NEW(DPAD_LEFT | DPAD_RIGHT))
+            changed |= HelixSettings_Request(HELIX_SETTINGS_SET_LANGUAGE, JOY_NEW(DPAD_RIGHT) ? 1 : 0);
+    }
+    if (changed)
+        DrawHelixSettings();
+}
