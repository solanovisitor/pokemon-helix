diff --git a/data/maps/LittlerootTown/scripts.inc b/data/maps/LittlerootTown/scripts.inc
index 6a2c6af41bb1d1a4d27cb2b74fbe655b53641cf9..b90ac75cd871f8e5a4f4ccdc7c00e711ca710582 100644
--- a/data/maps/LittlerootTown/scripts.inc
+++ b/data/maps/LittlerootTown/scripts.inc
@@ -246,19 +246,670 @@ LittlerootTown_EventScript_FatMan::
 	end
 
 LittlerootTown_EventScript_Boy::
-	msgbox LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC
+	lock
+	faceplayer
+	special GetHelixSignalRoute
+	goto_if_eq VAR_RESULT, 1, HelixSignal_Ivo
+	goto_if_eq VAR_RESULT, 2, HelixSignal_Unavailable
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_NOT_STARTED, LittlerootTown_EventScript_IvoFirstMeeting
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_CLUE_FOUND, LittlerootTown_EventScript_IvoReportClue
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_REPORTED, LittlerootTown_EventScript_IvoRemember
+	msgbox LittlerootTown_Text_IvoReminder, MSGBOX_DEFAULT
+	goto LittlerootTown_EventScript_IvoDialogue
+
+LittlerootTown_EventScript_IvoFirstMeeting::
+	msgbox LittlerootTown_Text_IvoIntroduction, MSGBOX_DEFAULT
+	dynmultichoice 1, 1, FALSE, 2, 0, DYN_MULTICHOICE_CB_NONE, LittlerootTown_Text_ChooseDiscover, LittlerootTown_Text_ChooseHelp
+	goto_if_eq VAR_RESULT, MULTI_B_PRESSED, LittlerootTown_EventScript_IvoDecline
+	setvar VAR_SIGNAL_MOTIVATION, SIGNAL_MOTIVATION_CURIOSITY
+	call_if_eq VAR_RESULT, 1, LittlerootTown_EventScript_IvoChooseHelp
+	setvar VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_ACCEPTED
+	msgbox LittlerootTown_Text_IvoDirections, MSGBOX_DEFAULT
+	goto LittlerootTown_EventScript_IvoDialogue
+
+LittlerootTown_EventScript_IvoChooseHelp::
+	setvar VAR_SIGNAL_MOTIVATION, SIGNAL_MOTIVATION_VILLAGE
+	return
+
+LittlerootTown_EventScript_IvoDecline::
+	msgbox LittlerootTown_Text_IvoDeclined, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_IvoReportClue::
+	msgbox LittlerootTown_Text_IvoClueReport, MSGBOX_DEFAULT
+	@ Authored scripts alone commit progress. Model text cannot set variables.
+	setvar VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_REPORTED
+	goto LittlerootTown_EventScript_IvoRemember
+
+LittlerootTown_EventScript_IvoRemember::
+	goto_if_eq VAR_SIGNAL_MOTIVATION, SIGNAL_MOTIVATION_VILLAGE, LittlerootTown_EventScript_IvoRememberHelp
+	msgbox LittlerootTown_Text_IvoRemembersCuriosity, MSGBOX_DEFAULT
+	goto LittlerootTown_EventScript_IvoDialogue
+
+LittlerootTown_EventScript_IvoRememberHelp::
+	msgbox LittlerootTown_Text_IvoRemembersHelp, MSGBOX_DEFAULT
+
+LittlerootTown_EventScript_IvoDialogue::
+	message LittlerootTown_Text_IvoListening
+	waitmessage
+	special RequestIvoDialogue
+	waitstate
+	goto_if_eq VAR_RESULT, AI_BRIDGE_RESULT_CANCELLED, LittlerootTown_EventScript_IvoFinish
+	msgbox gStringVar4, MSGBOX_DEFAULT
+LittlerootTown_EventScript_IvoFinish::
+	special EndAiDialogue
+	release
+	end
+
+LittlerootTown_EventScript_SignalClue::
+	lock
+	faceplayer
+	special GetHelixSignalRoute
+	goto_if_eq VAR_RESULT, 1, HelixSignal_Beacon
+	goto_if_eq VAR_RESULT, 2, HelixSignal_Unavailable
+	goto_if_eq VAR_AURORA_INVESTIGATION, AURORA_QUEST_NORTH_DECODED, LittlerootTown_EventScript_AuroraHomeAnswer
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_REPORTED, LittlerootTown_EventScript_AuroraIndividual
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_NOT_STARTED, LittlerootTown_EventScript_SignalClueBeforeMeeting
+	goto_if_ge VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_CLUE_FOUND, LittlerootTown_EventScript_SignalClueReadAgain
+	msgbox LittlerootTown_Text_SignalClueFound, MSGBOX_DEFAULT
+	setvar VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_CLUE_FOUND
+	msgbox LittlerootTown_Text_SignalClueReturn, MSGBOX_DEFAULT
+	release
 	end
 
+LittlerootTown_EventScript_SignalClueBeforeMeeting::
+	msgbox LittlerootTown_Text_SignalClueUnknown, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_SignalClueReadAgain::
+	msgbox LittlerootTown_Text_SignalClueReadAgain, MSGBOX_DEFAULT
+	release
+	end
+
+@ Helix uses the existing quest/motivation, without a new persistent field.
+@ VAR_0x800A exposes the current presentation phase for read-only verification.
+HelixSignal_Ivo::
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_CLUE_FOUND, HelixSignal_Report
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_REPORTED, HelixSignal_Remember
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_ACCEPTED, HelixSignal_Reminder
+	goto_if_ne VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_NOT_STARTED, HelixSignal_Unavailable
+	special GetHelixSignalReady
+	goto_if_eq VAR_RESULT, 0, HelixSignal_Unavailable
+	goto_if_ge VAR_RESULT, 4, HelixSignal_Unavailable
+	setvar VAR_0x800A, 1
+	setvar VAR_0x8004, 0
+	special BufferHelixSignalPage
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	closemessage
+	setvar VAR_0x800A, 2
+	special GetHelixLabLanguage
+	goto_if_eq VAR_RESULT, 1, HelixSignal_MotivationPT
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_DiscoverEN, HelixSignal_Text_HelpEN, HelixSignal_Text_CancelEN
+	goto HelixSignal_MotivationChoice
+HelixSignal_MotivationPT:
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_DiscoverPT, HelixSignal_Text_HelpPT, HelixSignal_Text_CancelPT
+HelixSignal_MotivationChoice:
+	goto_if_ge VAR_RESULT, 2, HelixSignal_Decline
+	copyvar VAR_SIGNAL_MOTIVATION, VAR_RESULT
+	addvar VAR_SIGNAL_MOTIVATION, 1
+	setvar VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_ACCEPTED
+	setvar VAR_0x800A, 3
+	setvar VAR_0x8004, 1
+	goto HelixSignal_PageAndFinish
+HelixSignal_Reminder:
+	setvar VAR_0x800A, 4
+	setvar VAR_0x8004, 2
+	goto HelixSignal_PageAndFinish
+HelixSignal_Decline:
+	setvar VAR_0x8004, 13
+	goto HelixSignal_PageAndFinish
+HelixSignal_Report:
+	setvar VAR_0x800A, 13
+	setvar VAR_0x8004, 9
+	special BufferHelixSignalPage
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	setvar VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_REPORTED
+HelixSignal_Remember:
+	setvar VAR_0x800A, 14
+	setvar VAR_0x8004, 10
+	goto HelixSignal_PageAndFinish
+
+HelixSignal_Beacon::
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_NOT_STARTED, HelixSignal_BeforeMeeting
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_REPORTED, HelixSignal_ReplayMenu
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_CLUE_FOUND, HelixSignal_Review
+	goto_if_ne VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_ACCEPTED, HelixSignal_Unavailable
+HelixSignal_Observe:
+	setvar VAR_0x800A, 6
+	closemessage
+	call HelixSignal_DoublePulse
+	setvar VAR_0x8004, 4
+	special BufferHelixSignalPage
+	msgbox gStringVar4, MSGBOX_DEFAULT
+HelixSignal_ObserveMenu:
+	closemessage
+	setvar VAR_0x800A, 7
+	special GetHelixLabLanguage
+	goto_if_eq VAR_RESULT, 1, HelixSignal_ObservePT
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_WatchEN, HelixSignal_Text_AnswerEN, HelixSignal_Text_LeaveEN
+	goto HelixSignal_ObserveChoice
+HelixSignal_ObservePT:
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_WatchPT, HelixSignal_Text_AnswerPT, HelixSignal_Text_LeavePT
+HelixSignal_ObserveChoice:
+	goto_if_eq VAR_RESULT, 0, HelixSignal_Observe
+	goto_if_ne VAR_RESULT, 1, HelixSignal_Finish
+	special GetHelixSignalReady
+	goto_if_ne VAR_RESULT, 1, HelixSignal_Unavailable
+	setvar VAR_0x800A, 8
+	setvar VAR_0x8004, 5
+	special BufferHelixSignalPage
+	showmonpic VAR_0x8009, 10, 3
+	playse SE_PC_ON
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	hidemonpic
+	closemessage
+	setvar VAR_0x800A, 9
+	special GetHelixLabLanguage
+	goto_if_eq VAR_RESULT, 1, HelixSignal_RhythmPT
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_OnceEN, HelixSignal_Text_TwiceEN, HelixSignal_Text_LeaveEN
+	goto HelixSignal_RhythmChoice
+HelixSignal_RhythmPT:
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_OncePT, HelixSignal_Text_TwicePT, HelixSignal_Text_LeavePT
+HelixSignal_RhythmChoice:
+	goto_if_eq VAR_RESULT, 0, HelixSignal_WrongRhythm
+	goto_if_ne VAR_RESULT, 1, HelixSignal_Finish
+	special GetHelixSignalReady
+	goto_if_ne VAR_RESULT, 1, HelixSignal_Unavailable
+	closemessage
+	playse SE_SELECT
+	delay 18
+	playse SE_SELECT
+	delay 24
+	call HelixSignal_DoublePulse
+	playse SE_PC_LOGIN
+	setvar VAR_0x800A, 11
+	setvar VAR_0x8004, 7
+	special BufferHelixSignalPage
+	msgbox gStringVar4, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, HelixSignal_ObserveMenu
+	@ B/No above leaves the saved quest untouched. Recheck before committing.
+	special GetHelixSignalReady
+	goto_if_ne VAR_RESULT, 1, HelixSignal_Unavailable
+	setvar VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_CLUE_FOUND
+	setvar VAR_0x800A, 12
+	setvar VAR_0x8004, 8
+	goto HelixSignal_PageAndFinish
+HelixSignal_WrongRhythm:
+	setvar VAR_0x800A, 10
+	playse SE_SELECT
+	delay 18
+	playse SE_PC_OFF
+	setvar VAR_0x8004, 6
+	special BufferHelixSignalPage
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	goto HelixSignal_Observe
+HelixSignal_BeforeMeeting:
+	setvar VAR_0x800A, 5
+	setvar VAR_0x8004, 3
+	goto HelixSignal_PageAndFinish
+HelixSignal_Unavailable:
+	setvar VAR_0x800A, 16
+	setvar VAR_0x8004, 12
+	goto HelixSignal_PageAndFinish
+HelixSignal_Review:
+	setvar VAR_0x800A, 17
+	setvar VAR_0x8004, 11
+	special BufferHelixSignalPage
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	goto_if_eq VAR_SIGNAL_QUEST_STATE, SIGNAL_QUEST_REPORTED, HelixSignal_ReplayMenu
+	setvar VAR_0x8004, 8
+	goto HelixSignal_PageAndFinish
+HelixSignal_ReplayMenu:
+	setvar VAR_0x800A, 15
+	closemessage
+	special GetHelixLabLanguage
+	goto_if_eq VAR_RESULT, 1, HelixSignal_ReplayPT
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_ReviewEN, HelixSignal_Text_EarlierEN, HelixSignal_Text_LeaveEN
+	goto HelixSignal_ReplayChoice
+HelixSignal_ReplayPT:
+	dynmultichoice 1, 1, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, HelixSignal_Text_ReviewPT, HelixSignal_Text_EarlierPT, HelixSignal_Text_LeavePT
+HelixSignal_ReplayChoice:
+	goto_if_eq VAR_RESULT, 0, HelixSignal_Review
+	goto_if_ne VAR_RESULT, 1, HelixSignal_Finish
+	@ Existing historical companions remain inspectable; Helix never issues one.
+	setvar VAR_0x800A, 0
+	goto_if_eq VAR_AURORA_INVESTIGATION, AURORA_QUEST_NORTH_DECODED, LittlerootTown_EventScript_AuroraHomeAnswer
+	goto LittlerootTown_EventScript_AuroraIndividual
+HelixSignal_PageAndFinish:
+	special BufferHelixSignalPage
+	msgbox gStringVar4, MSGBOX_DEFAULT
+HelixSignal_Finish:
+	setvar VAR_0x800A, 0
+	closemessage
+	release
+	end
+
+HelixSignal_DoublePulse:
+	hideobjectat LOCALID_LITTLEROOT_SIGNAL_CLUE, MAP_LITTLEROOT_TOWN
+	delay 18
+	showobjectat LOCALID_LITTLEROOT_SIGNAL_CLUE, MAP_LITTLEROOT_TOWN
+	playse SE_PIN
+	delay 18
+	hideobjectat LOCALID_LITTLEROOT_SIGNAL_CLUE, MAP_LITTLEROOT_TOWN
+	delay 18
+	showobjectat LOCALID_LITTLEROOT_SIGNAL_CLUE, MAP_LITTLEROOT_TOWN
+	playse SE_PIN
+	delay 48
+	return
+
