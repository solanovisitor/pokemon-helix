+	lock
+	faceplayer
+	goto_if_eq VAR_AURORA_INVESTIGATION, AURORA_QUEST_UNMET, Route101_EventScript_AuroraRelayUnmet
+	special GetAuroraIndividualPartyState
+	goto_if_ne VAR_RESULT, AURORA_INDIVIDUAL_PARTY, Route101_EventScript_AuroraRelayNeedsLumifin
+	goto_if_ge VAR_AURORA_INVESTIGATION, AURORA_QUEST_RELAY_READ, Route101_EventScript_AuroraRelayRead
