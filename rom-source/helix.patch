+Route103_EventScript_AuroraSignal::
+	lock
+	faceplayer
+#if AURORA_COMBAT_ENABLED
+	goto_if_eq VAR_AURORA_INVESTIGATION, AURORA_QUEST_COMPLETE, HelixWild_Gate
+#endif
+#if AURORA_ADVENTURE_VARIANT != 0
+	goto_if_eq VAR_AURORA_INVESTIGATION, AURORA_QUEST_COMPLETE, Route103_EventScript_NorthPool
+#endif
+	goto_if_lt VAR_AURORA_INVESTIGATION, AURORA_QUEST_NORTH_SIGNAL, Route103_EventScript_AuroraSignalEarly
+	special GetAuroraIndividualBattleReady
+	goto_if_ne VAR_RESULT, TRUE, Route103_EventScript_AuroraSignalNeedsLead
+	goto_if_ge VAR_AURORA_INVESTIGATION, AURORA_QUEST_NORTH_DECODED, Route103_EventScript_AuroraSignalPractice
+	msgbox Route103_Text_AuroraSignalDisturbed, MSGBOX_DEFAULT
+	msgbox Route103_Text_AuroraSignalBattle, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Route103_EventScript_AuroraSignalFinish
+	goto Route103_EventScript_AuroraSignalStartBattle
+
+Route103_EventScript_AuroraSignalPractice::
+	msgbox Route103_Text_AuroraSignalPractice, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, Route103_EventScript_AuroraSignalFinish
+
+Route103_EventScript_AuroraSignalStartBattle::
+	closemessage
+	setwildbattle SPECIES_POOCHYENA, 3
+	dowildbattle
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_ne VAR_RESULT, B_OUTCOME_WON, Route103_EventScript_AuroraSignalRetry
+	special GetAuroraIndividualBattleWon
+	goto_if_ne VAR_RESULT, TRUE, Route103_EventScript_AuroraSignalRetry
+	goto_if_ge VAR_AURORA_INVESTIGATION, AURORA_QUEST_NORTH_DECODED, Route103_EventScript_AuroraSignalPracticeWon
+	msgbox Route103_Text_AuroraSignalDecoded, MSGBOX_DEFAULT
+	setvar VAR_AURORA_INVESTIGATION, AURORA_QUEST_NORTH_DECODED
+	msgbox Route103_Text_AuroraSignalReturn, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+
+Route103_EventScript_AuroraSignalPracticeWon::
+	msgbox Route103_Text_AuroraSignalPracticeWon, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+
+Route103_EventScript_AuroraSignalEarly::
+	msgbox Route103_Text_AuroraSignalEarly, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+
+Route103_EventScript_AuroraSignalNeedsLead::
+	msgbox Route103_Text_AuroraSignalNeedsLead, MSGBOX_DEFAULT
+	goto Route103_EventScript_AuroraSignalFinish
+
+Route103_EventScript_AuroraSignalRetry::
+	msgbox Route103_Text_AuroraSignalRetry, MSGBOX_DEFAULT
+Route103_EventScript_AuroraSignalFinish::
+	release
+	end
+
+Route103_Text_AuroraSignalEarly:
+	.string "A cyan light flashes by the river.\n"
+	.string "The pattern is incomplete.\p"
+	.string "MIRA in OLDALE is studying\n"
+	.string "the relays along this route.$"
+Route103_Text_AuroraSignalNeedsLead:
+	.string "Let LUMIFIN lead this investigation.\n"
+	.string "Put it first in your party.\p"
+	.string "If it has fainted, heal it at the\n"
+	.string "POKéMON CENTER in OLDALE.$"
+Route103_Text_AuroraSignalDisturbed:
+	.string "A POOCHYENA circles the beacon.\n"
+	.string "It jumps at every broken note.\p"
+	.string "LUMIFIN moves between it and you.\n"
+	.string "Your partner is ready to help.$"
+Route103_Text_AuroraSignalBattle:
+	.string "Battle the POOCHYENA with LUMIFIN\n"
+	.string "and clear the way to the beacon?$"
+Route103_Text_AuroraSignalRetry:
+	.string "The signal is still broken.\n"
+	.string "Rest your team, then try again.\p"
+	.string "Win with LUMIFIN leading to give\n"
+	.string "your partner time to listen.$"
+Route103_Text_AuroraSignalDecoded:
+	.string "The POOCHYENA retreats to the grass.\n"
+	.string "LUMIFIN touches the beacon.\p"
+	.string "Three notes. Two replies.\n"
+	.string "Then a final note from LUMIFIN.\p"
+	.string "A faded display lights up:\n"
+	.string "RIVER NURSERY - SAFE PASSAGE.\p"
+	.string "A chain of lights leads south,\n"
+	.string "all the way to LITTLEROOT.\p"
+	.string "The signal guides young POKéMON\n"
+	.string "between quiet pools.\p"
+	.string "LUMIFIN knew the missing note.\n"
+	.string "Your partner is part of this route.$"
+Route103_Text_AuroraSignalReturn:
+	.string "MIRA should hear this discovery.\n"
+	.string "Return to her in OLDALE.\p"
+	.string "The beacon now remembers\n"
+	.string "LUMIFIN's reply.$"
+Route103_Text_AuroraSignalPractice:
+	.string "The river beacon is working.\n"
+	.string "A POOCHYENA rustles in the grass.\p"
+	.string "Practice another battle\n"
+	.string "with LUMIFIN leading?$"
+Route103_Text_AuroraSignalPracticeWon:
+	.string "LUMIFIN's reply rings out clearly.\n"
+	.string "The river route stays open.$"
+
+@ North Pool objects are west-bank ground; no Surf or rival skip is needed.
