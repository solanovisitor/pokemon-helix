+static void DrawHelixTime(void)
+{
+    u8 text[13];
+    u32 minute = gHelixSettingsView.localMinute;
+    s32 offset = gHelixSettingsView.utcOffset;
+    if (minute == HELIX_SETTINGS_UNKNOWN_MINUTE)
+    {
+        AddTextPrinterParameterized(WIN_OPTIONS, FONT_SMALL, HELIX_TEXT(sHelixTime[gHelixSettingsView.timezoneMode]), 112, 50, TEXT_SKIP_DRAW, NULL);
+        return;
+    }
+    text[0] = CHAR_0 + minute / 60 / 10;
+    text[1] = CHAR_0 + minute / 60 % 10;
+    text[2] = CHAR_COLON;
+    text[3] = CHAR_0 + minute % 60 / 10;
+    text[4] = CHAR_0 + minute % 10;
+    text[5] = CHAR_SPACE;
+    text[6] = offset < 0 ? CHAR_HYPHEN : CHAR_PLUS;
+    if (offset < 0)
+        offset = -offset;
+    text[7] = CHAR_0 + offset / 60 / 10;
+    text[8] = CHAR_0 + offset / 60 % 10;
+    text[9] = CHAR_COLON;
+    text[10] = CHAR_0 + offset % 60 / 10;
+    text[11] = CHAR_0 + offset % 10;
+    text[12] = EOS;
+    AddTextPrinterParameterized(WIN_OPTIONS, FONT_SMALL, text, 112, 50, TEXT_SKIP_DRAW, NULL);
+}
