+LittlerootTown_EventScript_AuroraIndividual::
+	special GetHelixSignalRoute
+	goto_if_eq VAR_RESULT, 2, HelixSignal_Unavailable
+	goto_if_eq VAR_RESULT, 1, HelixLegacy_Inspect
+	special GetAuroraIndividualState
+	goto_if_eq VAR_RESULT, AURORA_INDIVIDUAL_UNSUPPORTED, LittlerootTown_EventScript_IndividualUnsupported
+	goto_if_eq VAR_RESULT, AURORA_INDIVIDUAL_PRESENT, LittlerootTown_EventScript_IndividualExisting
+	msgbox LittlerootTown_Text_IndividualHatch, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, LittlerootTown_EventScript_IndividualFinish
+	message LittlerootTown_Text_IndividualReceiving
+	waitmessage
+	special HatchAuroraIndividual
+	goto_if_eq VAR_RESULT, AI_BRIDGE_RESULT_INVALID, LittlerootTown_EventScript_IndividualFinish
+	goto_if_eq VAR_RESULT, AURORA_INDIVIDUAL_RESULT_PARTY_FULL, LittlerootTown_EventScript_IndividualPartyFull
+	waitstate
+	goto_if_eq VAR_RESULT, AI_BRIDGE_RESULT_CANCELLED, LittlerootTown_EventScript_IndividualFinish
+	msgbox LittlerootTown_Text_IndividualJoined, MSGBOX_DEFAULT
+	call_if_eq VAR_LITTLEROOT_TOWN_STATE, 0, LittlerootTown_EventScript_IndividualMeetRival
+	setvar VAR_0x8004, 0
+	goto LittlerootTown_EventScript_IndividualShow
+
+HelixLegacy_Inspect:
+	special GetAuroraIndividualPartyState
