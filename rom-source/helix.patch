+@ Aurora field lab. All effects are ordinary script/special transitions.
+OldaleTown_House1_EventScript_AuroraLab::
+	lock
+	faceplayer
+#if HELIX_GENESIS_ENABLED
+	special GetHelixGenesisState
+	goto_if_ne VAR_RESULT, 0, HelixLab_Reenter
+#endif
+#if AURORA_COMBAT_ENABLED
+	goto HelixLab_Entry
+#endif
+#if AURORA_ADVENTURE_VARIANT != 0
+	special GetAuroraAdventureState
+	goto_if_eq VAR_RESULT, 3, AuroraLab_AdventureOffer
+	goto_if_eq VAR_RESULT, 2, AuroraLab_AdventureInvalid
+#endif
+AuroraLab_LegacyMenu:
+	msgbox AuroraLab_Text_Welcome, MSGBOX_DEFAULT
+	closemessage
+	multichoice 12, 0, MULTI_AURORA_LAB, FALSE
+	switch VAR_RESULT
+	case 0, AuroraLab_Hatch
+	case 1, AuroraLab_Notes
+	case 2, AuroraLab_Rest
+	case 3, AuroraLab_Listen
+	case 4, AuroraLab_Edit
+	goto AuroraLab_Finish
+
+AuroraLab_Hatch:
+	setvar VAR_0x8005, 0
+	special GetAuroraRosterAge
+	goto_if_eq VAR_RESULT, 5, AuroraLab_Invalid
+	goto_if_eq VAR_0x8008, FALSE, AuroraLab_TooYoung
+	setvar VAR_0x8005, 1
+	special GetAuroraRosterState
+	goto_if_eq VAR_RESULT, 1, AuroraLab_RecoverParty
+	goto_if_eq VAR_RESULT, 2, AuroraLab_RecoverBox
+	goto_if_eq VAR_RESULT, 3, AuroraLab_Missing
+	goto_if_eq VAR_RESULT, 4, AuroraLab_Invalid
+	msgbox AuroraLab_Text_Hatch, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, AuroraLab_Finish
+	special AdoptAuroraRosterChild
+	goto_if_eq VAR_RESULT, 7, AuroraLab_Full
+	goto_if_ne VAR_RESULT, 1, AuroraLab_Invalid
+	playfanfare MUS_OBTAIN_ITEM
+	msgbox AuroraLab_Text_Hatched, MSGBOX_DEFAULT
+	waitfanfare
+	goto AuroraLab_Finish
+
+AuroraLab_RecoverParty:
+	special AdoptAuroraRosterChild
+	goto_if_ne VAR_RESULT, 1, AuroraLab_Invalid
+	goto AuroraLab_Already
+AuroraLab_RecoverBox:
+	special AdoptAuroraRosterChild
+	goto_if_ne VAR_RESULT, 2, AuroraLab_Invalid
+	goto AuroraLab_Boxed
+
+AuroraLab_Choose:
+	closemessage
+	multichoice 14, 0, MULTI_AURORA_INDIVIDUAL, FALSE
+	return
+
+AuroraLab_Notes:
+	call AuroraLab_Choose
+	goto_if_ge VAR_RESULT, 2, AuroraLab_Finish
+	copyvar VAR_0x8005, VAR_RESULT
+	special BufferAuroraRosterInfo
+	goto_if_eq VAR_RESULT, 5, AuroraLab_Invalid
+	msgbox AuroraLab_Text_Notes, MSGBOX_DEFAULT
+	goto_if_eq VAR_0x8008, FALSE, AuroraLab_YoungNotes
+	msgbox AuroraLab_Text_MatureNotes, MSGBOX_DEFAULT
+	goto_if_eq VAR_0x8005, 0, AuroraLab_Finish
+	goto_if_eq VAR_0x800A, 1, AuroraLab_GermlineNotes
+	goto_if_eq VAR_0x8009, 1, AuroraLab_SomaticNotes
+	goto AuroraLab_Finish
+AuroraLab_GermlineNotes:
+	msgbox AuroraLab_Text_GermlineNotes, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_SomaticNotes:
+	msgbox AuroraLab_Text_SomaticNotes, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_YoungNotes:
+	msgbox AuroraLab_Text_YoungNotes, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+
+AuroraLab_Rest:
+	msgbox AuroraLab_Text_Rest, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, AuroraLab_Finish
+	special RestAuroraRoster
+	goto_if_ne VAR_RESULT, 8, AuroraLab_Invalid
+	fadescreen FADE_TO_BLACK
+	special HealPlayerParty
+	fadescreen FADE_FROM_BLACK
+	msgbox AuroraLab_Text_Rested, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+
+AuroraLab_Listen:
+	call AuroraLab_Choose
+	goto_if_ge VAR_RESULT, 2, AuroraLab_Finish
+	copyvar VAR_0x8005, VAR_RESULT
+	special GetAuroraRosterAge
+	goto_if_eq VAR_RESULT, 5, AuroraLab_Invalid
+	goto_if_eq VAR_0x8008, FALSE, AuroraLab_TooYoung
+	special GetAuroraRosterSignal
+	goto_if_eq VAR_RESULT, FALSE, AuroraLab_Quiet
+	goto_if_ge VAR_0x8007, 13, AuroraLab_ClearSignal
+	msgbox AuroraLab_Text_FaintSignal, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_ClearSignal:
+	msgbox AuroraLab_Text_ClearSignal, MSGBOX_DEFAULT
+	goto_if_eq VAR_AURORA_LAB_CLUE, 1, AuroraLab_Finish
+	giveitem ITEM_POKE_BALL, 1
+	goto_if_eq VAR_RESULT, FALSE, AuroraLab_Finish
+	setvar VAR_AURORA_LAB_CLUE, 1
+	msgbox AuroraLab_Text_Reward, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_Quiet:
+	msgbox AuroraLab_Text_Quiet, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+
+AuroraLab_Edit:
+	setvar VAR_0x8005, 1
+	special GetAuroraRosterState
+	goto_if_eq VAR_RESULT, 2, AuroraLab_Boxed
+	goto_if_ne VAR_RESULT, 1, AuroraLab_Invalid
+	msgbox AuroraLab_Text_EditExplain, MSGBOX_DEFAULT
+	closemessage
+	multichoice 14, 0, MULTI_AURORA_EDIT, FALSE
+	goto_if_ge VAR_RESULT, 2, AuroraLab_Finish
+	copyvar VAR_0x8006, VAR_RESULT
+	addvar VAR_0x8006, 1
+	special PreviewAuroraRosterEdit
+	goto_if_eq VAR_RESULT, 11, AuroraLab_AlreadyEdited
+	goto_if_ne VAR_RESULT, 9, AuroraLab_Invalid
+	goto_if_eq VAR_0x8006, 2, AuroraLab_GermlinePreview
+	msgbox AuroraLab_Text_SomaticPreview, MSGBOX_DEFAULT
+	goto AuroraLab_ConfirmEdit
+AuroraLab_GermlinePreview:
+	msgbox AuroraLab_Text_GermlinePreview, MSGBOX_DEFAULT
+AuroraLab_ConfirmEdit:
+	msgbox AuroraLab_Text_ConfirmEdit, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, AuroraLab_CancelEdit
+	special CommitAuroraRosterEdit
+	goto_if_ne VAR_RESULT, 10, AuroraLab_Invalid
+	msgbox AuroraLab_Text_Edited, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_CancelEdit:
+	special CancelAuroraRosterEdit
+	msgbox AuroraLab_Text_Cancelled, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_AlreadyEdited:
+	msgbox AuroraLab_Text_AlreadyEdited, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_Already:
+	msgbox AuroraLab_Text_Already, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_Boxed:
+	msgbox AuroraLab_Text_Boxed, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_Missing:
+	msgbox AuroraLab_Text_Missing, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_Full:
+	msgbox AuroraLab_Text_Full, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_TooYoung:
+	msgbox AuroraLab_Text_TooYoung, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_Invalid:
+	msgbox AuroraLab_Text_Invalid, MSGBOX_DEFAULT
+AuroraLab_Finish:
+	special CancelAuroraRosterEdit
+	release
+	end
+
+AuroraLab_Text_Welcome:
+	.string "Welcome to the AURORA field lab.\n"
+	.string "Let's follow your family's story.$"
+AuroraLab_Text_Hatch:
+	.string "RIPPLE is LUMIFIN's offspring.\n"
+	.string "Its other parent lives at the lab.\p"
+	.string "Its inherited pattern is ready.\n"
+	.string "Hatch RIPPLE into your party?$"
+AuroraLab_Text_Hatched:
+	.string "RIPPLE joined your party!\n"
+	.string "A new life, with its own pattern.\p"
+	.string "Open its SUMMARY to meet it.\n"
+	.string "Save to keep your family's progress.$"
+AuroraLab_Text_Notes:
+	.string "{STR_VAR_1}: {STR_VAR_3}\n"
+	.string "Days observed: {STR_VAR_2}\p"
+	.string "Age advances when we rest here.\n"
+	.string "Training XP is counted separately.$"
+AuroraLab_Text_MatureNotes:
+	.string "Mature: ready for family studies.\n"
+	.string "Its acquired XP is never inherited.$"
+AuroraLab_Text_YoungNotes:
+	.string "Juvenile at day 3, mature at day 7.\n"
+	.string "Let this young partner take its time.$"
+AuroraLab_Text_GermlineNotes:
+	.string "Edit record: GERMLINE, revision 1.\n"
+	.string "Its edited allele can be inherited.$"
+AuroraLab_Text_SomaticNotes:
+	.string "Edit record: SOMATIC, revision 1.\n"
+	.string "Its inherited genome is unchanged.$"
+AuroraLab_Text_Rest:
+	.string "Rest for one simulated day?\n"
+	.string "Party and boxed family members age.\p"
+	.string "Your team will heal, but gain no XP.\n"
+	.string "Time away from the game won't count.$"
+AuroraLab_Text_Rested:
+	.string "A day passes beside the nursery.\n"
+	.string "Your partners are rested.$"
+AuroraLab_Text_TooYoung:
+	.string "Let this partner mature first.\n"
+	.string "The lab counts seven days of rest.$"
+AuroraLab_Text_FaintSignal:
+	.string "A faint reply: three notes, a pause.\n"
+	.string "Another voice hides beneath them.\p"
+	.string "A more sensitive partner might\n"
+	.string "separate those overlapping notes.$"
+AuroraLab_Text_ClearSignal:
+	.string "Your partner separates both voices!\n"
+	.string "The quiet one repeats: NORTH POOL.\p"
+	.string "MIRA's missing nursery has a name.\n"
+	.string "We'll mark it in the field notes.$"
+AuroraLab_Text_Reward:
+	.string "Take this POKé BALL for the journey.\n"
+	.string "This discovery is yours to keep.$"
+AuroraLab_Text_Quiet:
+	.string "No clear reply. Bring a healthy\n"
+	.string "family member out of the PC first.$"
+AuroraLab_Text_EditExplain:
+	.string "We can try one virtual allele edit.\n"
+	.string "This is our fictional DNA model.\p"
+	.string "SOMATIC changes RIPPLE's expression.\n"
+	.string "GERMLINE also changes inheritance.\p"
+	.string "The original record stays intact.\n"
+	.string "Each choice has a recorded revision.$"
+AuroraLab_Text_SomaticPreview:
+	.string "Preview: a new luminous pattern.\n"
+	.string "Only RIPPLE's expression changes.\p"
+	.string "Future young inherit its original\n"
+	.string "alleles. Training stays the same.$"
+AuroraLab_Text_GermlinePreview:
+	.string "Preview: a new luminous pattern.\n"
+	.string "One inherited allele also changes.\p"
+	.string "Future young may inherit that copy.\n"
+	.string "Training stays the same.$"
+AuroraLab_Text_ConfirmEdit:
+	.string "Apply this recorded edit to RIPPLE?\n"
+	.string "Its identity and XP will stay.$"
+AuroraLab_Text_Edited:
+	.string "The new revision is recorded.\n"
+	.string "See RIPPLE's pattern in SUMMARY.\p"
+	.string "Save to keep this change.\n"
+	.string "The lab retains its original record.$"
+AuroraLab_Text_Cancelled:
+	.string "Preview cancelled.\n"
+	.string "RIPPLE is unchanged.$"
+AuroraLab_Text_AlreadyEdited:
+	.string "That revision is already recorded.\n"
+	.string "The lab won't apply it twice.$"
+AuroraLab_Text_Already:
+	.string "RIPPLE is already with you.\n"
+	.string "There is only one of this individual.$"
+AuroraLab_Text_Boxed:
+	.string "RIPPLE is in a PC BOX.\n"
+	.string "Withdraw it to work together here.$"
+AuroraLab_Text_Missing:
+	.string "RIPPLE has already left this lab.\n"
+	.string "We cannot hatch that individual again.$"
+AuroraLab_Text_Full:
+	.string "Your party is full. Make room first.\n"
+	.string "The egg will wait here safely.$"
+AuroraLab_Text_Invalid:
+	.string "I need LUMIFIN's verified field notes.\n"
+	.string "Meet IVO and hatch its beacon egg.\p"
+	.string "If a record is damaged or unfamiliar,\n"
+	.string "we leave it untouched.$"
+
+#if AURORA_ADVENTURE_VARIANT != 0
+@ New content is issued once; the legacy menu keeps all original choice indices.
+AuroraLab_AdventureOffer:
+	msgbox AuroraLab_Text_AdventureOffer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, AuroraLab_LegacyMenu
+	special AdoptAuroraAdventureFamily
+	goto_if_eq VAR_RESULT, 7, AuroraLab_AdventureFull
+	goto_if_ne VAR_RESULT, 1, AuroraLab_AdventureInvalid
+	playfanfare MUS_OBTAIN_ITEM
+	msgbox AuroraLab_Text_AdventureJoined, MSGBOX_DEFAULT
+	waitfanfare
+	goto AuroraLab_Finish
+AuroraLab_AdventureFull:
+	msgbox AuroraLab_Text_AdventureFull, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_AdventureInvalid:
+	msgbox AuroraLab_Text_AdventureInvalid, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+AuroraLab_Text_AdventureOffer:
+	.string "Two new partners share a family\n"
+	.string "pattern, but each has its own form.\p"
+	.string "Their story belongs to this journey.\n"
+	.string "Welcome both into your party?$"
+AuroraLab_Text_AdventureJoined:
+	.string "Both family partners joined you!\n"
+	.string "Meet each one in its SUMMARY.\p"
+	.string "MIRA can guide your family to\n"
+	.string "NORTH POOL. Save your progress.$"
+AuroraLab_Text_AdventureFull:
+	.string "Make two free places in your party.\n"
+	.string "Use the POKéMON CENTER's PC.\p"
+	.string "This family will wait here for you.$"
+AuroraLab_Text_AdventureInvalid:
+	.string "This family cannot join this save.\n"
+	.string "Keep its matching adventure ROM.\p"
+	.string "Existing partners are unchanged.$"
+#endif
+
+#if AURORA_COMBAT_ENABLED
+HelixLab_Entry:
+	special GetAuroraCombatState
+	goto_if_eq VAR_RESULT, 0, HelixLab_Offer
+	goto_if_eq VAR_RESULT, 16, HelixLab_Migrate
+	goto_if_eq VAR_RESULT, 255, AuroraLab_AdventureInvalid
+	msgbox HelixLab_Text_Directions, MSGBOX_DEFAULT
+	goto AuroraLab_LegacyMenu
+HelixLab_Offer:
+	msgbox HelixLab_Text_Offer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, AuroraLab_LegacyMenu
+	special AdoptAuroraCombatParent
+	goto_if_eq VAR_RESULT, 7, HelixLab_Full
+	goto_if_ne VAR_RESULT, 1, AuroraLab_AdventureInvalid
+	giveitem ITEM_POKE_BALL, 5
+	msgbox HelixLab_Text_Joined, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+HelixLab_Full:
+	msgbox HelixLab_Text_Full, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+HelixLab_Migrate:
+	msgbox HelixLab_Text_Migrate, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, AuroraLab_Finish
+	special AdoptAuroraCombatParent
+	goto_if_ne VAR_RESULT, 1, AuroraLab_AdventureInvalid
+	msgbox HelixLab_Text_Migrated, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+HelixNursery_Offer:
+	lock
+	faceplayer
+	msgbox HelixNursery_Text_Offer, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, HelixNursery_Cancel
+	special CompleteAuroraCombatBirth
+	goto_if_eq VAR_RESULT, 1, HelixNursery_Born
+	goto_if_eq VAR_RESULT, 2, HelixNursery_Already
+	goto_if_eq VAR_RESULT, 7, HelixLab_Full
+	msgbox HelixNursery_Text_Parents, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+HelixNursery_Born:
+	playfanfare MUS_OBTAIN_ITEM
+	msgbox HelixNursery_Text_Born, MSGBOX_DEFAULT
+	waitfanfare
+	goto AuroraLab_Finish
+HelixNursery_Already:
+	msgbox HelixNursery_Text_Already, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+HelixNursery_Cancel:
+	msgbox HelixNursery_Text_Cancel, MSGBOX_DEFAULT
+	goto AuroraLab_Finish
+HelixLab_Text_Offer:
+	.string "This river partner has a family\n"
+	.string "waiting to grow. Travel together?$"
+HelixLab_Text_Joined:
+	.string "Your new partner joined you!\n"
+	.string "Its own traits shape its strengths.\p"
+	.string "Find its mate at the river beacon\n"
+	.string "on ROUTE 103. Bring POKé BALLS.\p"
+	.string "Save your adventure before you go.\n"
+	.string "Each partner is one of a kind.$"
+HelixLab_Text_Full:
+	.string "Make one free place in your party.\n"
+	.string "Your partner will wait safely here.$"
+HelixLab_Text_Directions:
+	.string "Find the wild partner at ROUTE 103's\n"
+	.string "river beacon. Try a POKé BALL!\p"
+	.string "Then bring both parents to the\n"
+	.string "woman beside me to grow the family.$"
+HelixLab_Text_Migrate:
+	.string "We can add battle notes for your\n"
+	.string "family's own traits. Update them?\p"
+	.string "Their XP, moves and history stay.\n"
+	.string "No past birth gives extra XP.$"
+HelixLab_Text_Migrated:
+	.string "Their new battle notes are ready.\n"
+	.string "All past progress is still here.\p"
+	.string "Their wild relative waits at\n"
+	.string "ROUTE 103's river beacon.$"
+HelixNursery_Text_Offer:
+	.string "Bring both river parents and leave\n"
+	.string "one party place for their young.\p"
+	.string "Shall we welcome their new child?$"
+HelixNursery_Text_Parents:
+	.string "Bring both parents in your party.\n"
+	.string "Catch the wild one at ROUTE 103.\p"
+	.string "We only learn from a successful\n"
+	.string "birth. Nobody gained XP yet.$"
+HelixNursery_Text_Born:
+	.string "A new child joined the family!\n"
+	.string "Its own inherited pattern is ready.\p"
+	.string "Both parents learned from this:\n"
+	.string "each gained 125 XP, just once.\p"
+	.string "Save to keep your family's story.\n"
+	.string "Meet your child in its SUMMARY.$"
+HelixNursery_Text_Already:
+	.string "This child has already been born.\n"
+	.string "Its parents keep what they learned.\p"
+	.string "Repeating our notes gives no XP.$"
+HelixNursery_Text_Cancel:
+	.string "Take your time. The family can wait.\n"
+	.string "No birth or XP was recorded.$"
+#endif
+
+HelixLab_Reenter:
+	msgbox HelixLab_Text_Reenter, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, AuroraLab_Finish
+	closemessage
+	warp MAP_HELIX_LABORATORY, 6, 10
+	waitstate
+	release
+	end
+HelixLab_Text_Reenter:
+	.string "The HELIX laboratory is at the back.\n"
+	.string "Go in and revisit your project?$"
